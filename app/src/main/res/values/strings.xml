    <!--
      Media notification / lock-screen transport actions. These replace Media3's
      stock "previous track" / "next track" actions, which are meaningless for a
      book loaded as a single media item. Read aloud by TalkBack, so they spell
      out the jump amount. Also used by the in-app player's jump buttons.
    -->
    <plurals name="notification_action_jump_backward">
        <item quantity="one">Back %d second</item>
        <item quantity="other">Back %d seconds</item>
    </plurals>
